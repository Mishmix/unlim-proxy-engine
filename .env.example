# Copy to .env and adjust. Every variable here is optional.

# Optional API key. If set, every /v1/* request must send `X-API-Key: <value>`.
# If unset, the API is open (fine for localhost, not for a public VPS).
API_KEY=

# Any config.toml value can be overridden as UNLIMPROXY_<SECTION>__<KEY>.
# UNLIMPROXY_APP__LOG_LEVEL=DEBUG
# UNLIMPROXY_APP__PORT=8000
# UNLIMPROXY_APP__ROTATION_COOLDOWN_SEC=30
# UNLIMPROXY_QUEUES__COLD_CONCURRENCY=400
