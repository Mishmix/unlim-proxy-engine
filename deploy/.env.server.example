# Шаблон для ${STACK_ROOT}/.env на сервере — то есть /opt/stacks/unlimproxy/.env
#
# Только ИМЕНА, значения проставляет владелец на сервере. Этот файл в гите,
# сам .env — никогда (push.sh его исключает из rsync).
#
# Приложение читает ровно два вида переменных (config.py):
#   API_KEY                          — отдельным алиасом
#   UNLIMPROXY_<СЕКЦИЯ>__<КЛЮЧ>      — перекрывает любое поле config.toml
# Ничего больше в коде не читается: os.getenv встречается один раз, для
# UNLIMPROXY_CONFIG. Railway-переменная PORT приложением НЕ используется — её
# требовал сам Railway, на новом сервере она не нужна.

# ─── обязательное ────────────────────────────────────────────────────────────

# Ключ доступа к /v1/*. Пустое значение = пул открыт всему интернету, а адрес
# публичный. Можно перечислить несколько через запятую (api.py:192).
API_KEY=

# ─── опциональное, только если надо отклониться от config.toml ───────────────

# Каталог с базой и geo-файлами уже смонтирован в /app/data, трогать не нужно.
# UNLIMPROXY_APP__DB_PATH=
# UNLIMPROXY_APP__ROTATION_COOLDOWN_SEC=
# UNLIMPROXY_APP__ROTATION_TOP_N=
# UNLIMPROXY_SCRAPER__INTERVAL_SEC=
# UNLIMPROXY_QUEUES__HOT_CONCURRENCY=
# UNLIMPROXY_QUEUES__WARM_CONCURRENCY=
# UNLIMPROXY_QUEUES__YT_CONCURRENCY=

# ─── НЕ здесь ────────────────────────────────────────────────────────────────
#
# COLD_CONCURRENCY и LOG_LEVEL живут в deploy/stack.env, а не тут: их
# подставляет сам compose при интерполяции, и блок environment: перебивает
# env_file. Значение из этого файла просто не доедет.
#
# COLD_CONCURRENCY на новом сервере понижен 300 -> 100: на Railway машина была
# отдельная, здесь два ядра на весь стек. См. комментарий в deploy/stack.env.
