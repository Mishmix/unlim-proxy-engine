# Переменные СБОРКИ стека, не секреты. Этот файл живёт в гите.
#
# Читает его docker compose (--env-file), а не приложение: значения отсюда
# подставляются в compose.yml через ${...}. Секреты (API_KEY) сюда не класть —
# им место в ${STACK_ROOT}/.env, который compose отдаёт контейнеру через env_file.
#
# На сервере файл лежит в ${STACK_ROOT}/deploy/stack.env — push.sh кладёт его
# туда сам при каждом деплое, править на сервере смысла нет: перезапишется.

STACK_NAME=unlimproxy
STACK_ROOT=/opt/stacks/unlimproxy

# Имя в сети edge, по которому до сервиса достучится Caddy платформенного стека.
# Должно быть уникальным по всем стекам: имена сервисов схлопываются (у двух
# других проектов сервис называется просто "web"), алиас — то, что их разводит.
EDGE_ALIAS=unlimproxy

# Одновременных проверок в холодной очереди.
#
# На Railway было 300 (ниже дефолта 1000 из config.toml) и уходило 0,118 vCPU в
# среднем. Здесь два ядра на ВЕСЬ сервер и десяток соседних контейнеров, поэтому
# старт берём с 100. Автор мерил, что упирается всё в сеть, а не в процессор
# (CPU < 10 % даже на 3000), так что это ограничение по вежливости к соседям, а
# не по нагрузке. Если pool_alive в /v1/stats начнёт проседать — поднимать до
# 300 и смотреть на docker stats, это первая ручка.
COLD_CONCURRENCY=100

LOG_LEVEL=INFO
